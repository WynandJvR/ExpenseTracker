<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.wyn.expensetracker.DashboardController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane">
    <VBox spacing="20" styleClass="content-view">
        <padding><Insets top="28" right="32" bottom="28" left="32"/></padding>

        <VBox spacing="4">
            <Label fx:id="overviewTitle" text="Overview" styleClass="view-title"/>
            <Label fx:id="overviewSubtitle" text="" styleClass="view-subtitle" wrapText="true"/>
        </VBox>

        <!-- Things that need the user's attention (uncategorised, stale statements, budgets) -->
        <VBox fx:id="attentionBox" spacing="8"/>
        <VBox fx:id="budgetAlertBox" spacing="8"/>

        <!-- Headline numbers -->
        <GridPane fx:id="kpiGrid" hgap="14" vgap="14">
            <columnConstraints>
                <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
            </columnConstraints>
            <VBox styleClass="kpi-card" GridPane.columnIndex="0" spacing="4">
                <Label text="Money in" styleClass="kpi-label"/>
                <Label fx:id="kpiInValue" text="—" styleClass="kpi-value"/>
                <Label fx:id="kpiInSub" text="" styleClass="kpi-sub" wrapText="true"/>
            </VBox>
            <VBox styleClass="kpi-card" GridPane.columnIndex="1" spacing="4">
                <Label text="Money out" styleClass="kpi-label"/>
                <Label fx:id="kpiOutValue" text="—" styleClass="kpi-value"/>
                <Label fx:id="kpiOutSub" text="" styleClass="kpi-sub" wrapText="true"/>
            </VBox>
            <VBox styleClass="kpi-card" GridPane.columnIndex="2" spacing="4">
                <Label text="Left over" styleClass="kpi-label"/>
                <Label fx:id="kpiNetValue" text="—" styleClass="kpi-value"/>
                <Label fx:id="kpiNetSub" text="" styleClass="kpi-sub" wrapText="true"/>
            </VBox>
            <VBox styleClass="kpi-card" GridPane.columnIndex="3" spacing="4">
                <Label text="Account balance" styleClass="kpi-label"/>
                <Label fx:id="kpiBalanceValue" text="—" styleClass="kpi-value"/>
                <Label fx:id="kpiBalanceSub" text="" styleClass="kpi-sub" wrapText="true"/>
            </VBox>
        </GridPane>

        <!-- Spending by category + six-month trend -->
        <HBox spacing="16" alignment="TOP_LEFT">
            <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS" minWidth="240" prefWidth="520">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Where your money went" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="categorySummaryLabel" styleClass="muted-text"/>
                </HBox>
                <VBox fx:id="categoryBars" spacing="10"/>
                <Label text="Click a category for its totals and where the money goes · right-click to set a budget." styleClass="faint-text" wrapText="true"/>
            </VBox>
            <VBox spacing="8" styleClass="card" HBox.hgrow="ALWAYS" minWidth="240" prefWidth="460">
                <Label text="Money in vs out · last 6 months" styleClass="card-title"/>
                <BarChart fx:id="trendChart" styleClass="trend-chart" legendVisible="true" animated="false"
                          prefHeight="300" categoryGap="18" barGap="2">
                    <xAxis><CategoryAxis side="BOTTOM" tickLabelGap="6"/></xAxis>
                    <yAxis><NumberAxis side="LEFT" minorTickVisible="false" forceZeroInRange="true"/></yAxis>
                </BarChart>
            </VBox>
        </HBox>

        <!-- Upcoming bills and unusual spending -->
        <VBox fx:id="remindersBox" spacing="8"/>
        <VBox fx:id="anomalyBox" spacing="8"/>

        <!-- Goals, debts, exchange rates -->
        <HBox spacing="16" alignment="TOP_LEFT">
            <VBox fx:id="goalsBox" spacing="10" styleClass="card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Savings goals" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Manage" styleClass="ghost-button" onAction="#handleManageGoals"/>
                </HBox>
                <VBox fx:id="goalsProgressBox" spacing="10"/>
            </VBox>
            <VBox fx:id="debtSummaryBox" spacing="10" styleClass="card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="Debts" styleClass="card-title"/>
                <VBox fx:id="debtSummaryContent" spacing="6"/>
            </VBox>
            <VBox fx:id="exchangeRatesBox" spacing="10" styleClass="card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Exchange rates" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Edit" styleClass="ghost-button" onAction="#handleEditExchangeRates"/>
                </HBox>
                <VBox fx:id="exchangeRatesContent" spacing="4"/>
            </VBox>
        </HBox>

        <!-- Income detail (collapsed by default) -->
        <TitledPane fx:id="incomePane" text="Income this month" expanded="false" styleClass="card-titled-pane">
            <VBox spacing="12">
                <Label fx:id="incomeTabSummary" text="" styleClass="muted-text" wrapText="true"/>
                <TableView fx:id="incomeTable" styleClass="table-view" prefHeight="200">
                    <columns>
                        <TableColumn text="Amount" prefWidth="110">
                            <cellValueFactory><PropertyValueFactory property="amount"/></cellValueFactory>
                        </TableColumn>
                        <TableColumn text="Category" prefWidth="120">
                            <cellValueFactory><PropertyValueFactory property="category"/></cellValueFactory>
                        </TableColumn>
                        <TableColumn text="Date" prefWidth="100">
                            <cellValueFactory><PropertyValueFactory property="date"/></cellValueFactory>
                        </TableColumn>
                        <TableColumn text="Description" prefWidth="260">
                            <cellValueFactory><PropertyValueFactory property="description"/></cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="Delete selected" styleClass="ghost-danger-button" onAction="#handleDeleteIncome"/>
                    <Label fx:id="incomeErrorLabel" styleClass="error-label"/>
                </HBox>
                <Separator/>
                <Label text="Planned income (optional)" styleClass="card-title"/>
                <Label text="Only used for months with no income in your statements, e.g. to plan ahead."
                       styleClass="muted-text" wrapText="true"/>
                <VBox fx:id="incomeFieldsBox" spacing="6">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Every month" styleClass="form-label"/>
                            <TextField fx:id="recurringIncomeField" promptText="e.g. 15000.00"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="This month only" styleClass="form-label"/>
                            <TextField fx:id="incomeField" promptText="Leave empty to use the monthly amount"/>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
        </TitledPane>

        <Label fx:id="errorLabel" styleClass="error-label"/>
    </VBox>
</ScrollPane>
