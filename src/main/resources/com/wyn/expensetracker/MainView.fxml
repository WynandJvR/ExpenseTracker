<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.wyn.expensetracker.MainController"
            styleClass="root-pane">
    <top>
        <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="10">
            <padding><Insets top="6" right="15" bottom="6" left="15"/></padding>
            <Button fx:id="undoButton" text="Undo" styleClass="primary-button" disable="true" onAction="#handleUndo">
                <tooltip><Tooltip text="Undo (Ctrl+Z)"/></tooltip>
            </Button>
            <Button fx:id="redoButton" text="Redo" styleClass="primary-button" disable="true" onAction="#handleRedo">
                <tooltip><Tooltip text="Redo (Ctrl+Y)"/></tooltip>
            </Button>
            <Button text="?" styleClass="help-button" onAction="#handleShowShortcuts">
                <tooltip><Tooltip text="Keyboard Shortcuts (Ctrl+/ or F1)"/></tooltip>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="&#x25C0;" styleClass="nav-arrow" onAction="#handlePrevMonth">
                <tooltip><Tooltip text="Previous Month (Alt+Left)"/></tooltip>
            </Button>
            <HBox spacing="6" alignment="CENTER" styleClass="period-display">
                <padding><Insets top="4" right="12" bottom="4" left="12"/></padding>
                <ComboBox fx:id="monthCombo" promptText="Month" styleClass="period-combo"/>
                <ComboBox fx:id="yearCombo" promptText="Year" styleClass="period-combo"/>
            </HBox>
            <Button text="&#x25B6;" styleClass="nav-arrow" onAction="#handleNextMonth">
                <tooltip><Tooltip text="Next Month (Alt+Right)"/></tooltip>
            </Button>
            <Button text="Today" styleClass="today-button" onAction="#handleThisMonth"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Currency:" styleClass="form-label"/>
            <ComboBox fx:id="currencyCombo" styleClass="combo-box"/>
        </HBox>
    </top>

    <left>
        <VBox styleClass="sidebar-nav">
            <padding><Insets top="12" bottom="12" left="4" right="4"/></padding>
            <ToggleButton fx:id="navDashboard" text="Dashboard" styleClass="sidebar-nav-button" maxWidth="Infinity"/>
            <ToggleButton fx:id="navExpenses" text="Expenses" styleClass="sidebar-nav-button" maxWidth="Infinity"/>
            <ToggleButton fx:id="navRecurring" text="Recurring" styleClass="sidebar-nav-button" maxWidth="Infinity"/>
            <ToggleButton fx:id="navImport" text="Import" styleClass="sidebar-nav-button" maxWidth="Infinity"/>
            <ToggleButton fx:id="navAnalytics" text="Analytics" styleClass="sidebar-nav-button" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">

            <!-- ==================== DASHBOARD VIEW ==================== -->
            <ScrollPane fx:id="dashboardView" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane">
                <VBox spacing="18" styleClass="content-view">
                    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

                    <Label text="Dashboard" styleClass="view-title"/>

                    <!-- Dashboard Cards -->
                    <HBox fx:id="dashboardCards" spacing="12" alignment="CENTER_LEFT">
                        <VBox styleClass="dashboard-card dashboard-card-spent" alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="Total Spent" styleClass="dashboard-card-title"/>
                            <TextField fx:id="dashTotalSpent" text="0.00" editable="false" styleClass="dashboard-card-value-field" alignment="CENTER"/>
                        </VBox>
                        <VBox styleClass="dashboard-card dashboard-card-top" alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="Top Category" styleClass="dashboard-card-title"/>
                            <TextField fx:id="dashTopCategory" text="-" editable="false" styleClass="dashboard-card-value-field" alignment="CENTER"/>
                            <TextField fx:id="dashTopCategoryAmount" text="" editable="false" styleClass="dashboard-card-subtitle-field" alignment="CENTER"/>
                        </VBox>
                        <VBox styleClass="dashboard-card dashboard-card-budget" alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="Budget Status" styleClass="dashboard-card-title"/>
                            <TextField fx:id="dashBudgetStatus" text="-" editable="false" styleClass="dashboard-card-value-field" alignment="CENTER"/>
                            <TextField fx:id="dashBudgetSubtitle" text="" editable="false" styleClass="dashboard-card-subtitle-field" alignment="CENTER"/>
                        </VBox>
                        <VBox styleClass="dashboard-card dashboard-card-trend" alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="vs Last Month" styleClass="dashboard-card-title"/>
                            <TextField fx:id="dashMonthChange" text="-" editable="false" styleClass="dashboard-card-value-field" alignment="CENTER"/>
                        </VBox>
                    </HBox>

                    <!-- Budget Section -->
                    <VBox spacing="8" styleClass="panel-box">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Budget:" styleClass="form-label"/>
                            <Label fx:id="moneySavedLabel" text="Money Saved: 0.00" styleClass="saved-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="toggleIncomeButton" text="Edit" styleClass="secondary-button" onAction="#handleToggleIncome"/>
                        </HBox>
                        <Label fx:id="totalLabel" text="Total Expenses: 0.00" styleClass="total-label"/>
                        <VBox fx:id="incomeFieldsBox" spacing="5" visible="false" managed="false">
                            <Label text="Projected Monthly Income:" styleClass="form-label"/>
                            <TextField fx:id="recurringIncomeField" promptText="e.g., 15000.00" styleClass="text-field"/>
                            <Label text="This Month (projected):" styleClass="form-label"/>
                            <TextField fx:id="incomeField" promptText="Leave empty to use default" styleClass="text-field"/>
                        </VBox>
                    </VBox>

                    <!-- Income Transactions -->
                    <VBox spacing="8" styleClass="panel-box">
                        <Label text="Income Transactions" styleClass="section-title"/>
                        <Label fx:id="incomeTabSummary" text="" styleClass="form-label"/>
                        <TableView fx:id="incomeTable" styleClass="table-view" prefHeight="200">
                            <columns>
                                <TableColumn text="Amount" prefWidth="100">
                                    <cellValueFactory><PropertyValueFactory property="amount"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Category" prefWidth="120">
                                    <cellValueFactory><PropertyValueFactory property="category"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Date" prefWidth="100">
                                    <cellValueFactory><PropertyValueFactory property="date"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Description" prefWidth="200">
                                    <cellValueFactory><PropertyValueFactory property="description"/></cellValueFactory>
                                </TableColumn>
                            </columns>
                        </TableView>
                        <HBox spacing="10">
                            <Button text="Delete Selected" styleClass="danger-button" onAction="#handleDeleteIncome"/>
                        </HBox>
                        <Label fx:id="incomeErrorLabel" styleClass="error-label"/>
                    </VBox>

                    <Label fx:id="errorLabel" styleClass="error-label"/>
                </VBox>
            </ScrollPane>

            <!-- ==================== EXPENSES VIEW ==================== -->
            <ScrollPane fx:id="expensesView" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane" visible="false" managed="false">
                <VBox spacing="12" styleClass="content-view">
                    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

                    <Label text="Expenses" styleClass="view-title"/>

                    <!-- Add Expense Form (collapsible) -->
                    <TitledPane fx:id="addExpensePane" text="Add New Expense" expanded="true" styleClass="form-titled-pane">
                        <VBox fx:id="expenseTabContent" spacing="8" styleClass="panel-box">
                            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

                            <HBox spacing="16">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Amount:" styleClass="form-label"/>
                                    <TextField fx:id="amountField" promptText="e.g., 10.99" styleClass="text-field"/>
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Category:" styleClass="form-label"/>
                                    <ComboBox fx:id="categoryCombo" promptText="Select or enter category" styleClass="combo-box" maxWidth="1.7976931348623157E308"/>
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Date:" styleClass="form-label"/>
                                    <DatePicker fx:id="datePicker" promptText="Select Date" styleClass="date-picker" maxWidth="1.7976931348623157E308"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="16" alignment="CENTER_LEFT">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Description (optional):" styleClass="form-label"/>
                                    <TextField fx:id="descriptionField" promptText="Enter description" styleClass="text-field" onAction="#handleAddExpense"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Button fx:id="addButton" text="Add Expense" styleClass="success-button" onAction="#handleAddExpense"/>
                                <Button text="+ Category" styleClass="secondary-button" onAction="#handleAddCategory"/>
                                <Button text="- Category" styleClass="secondary-button" onAction="#handleRemoveCategory"/>
                            </HBox>
                            <Label fx:id="expenseErrorLabel" styleClass="error-label"/>
                        </VBox>
                    </TitledPane>

                    <!-- Filters -->
                    <VBox spacing="8">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="searchField" promptText="Search expenses..." styleClass="text-field search-field" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="filterToggleButton" text="Filters" styleClass="secondary-button" onAction="#handleToggleFilters"/>
                            <Region HBox.hgrow="SOMETIMES" minWidth="10"/>
                            <Button fx:id="deleteButton" text="Delete Selected" styleClass="danger-button" onAction="#handleDeleteExpense"/>
                            <Button text="Export All" styleClass="success-button" onAction="#handleExport"/>
                            <Button text="Export View" styleClass="primary-button" onAction="#handleExportFiltered"/>
                        </HBox>
                        <HBox fx:id="filterFieldsBox" spacing="10" alignment="CENTER_LEFT" visible="false" managed="false" styleClass="filter-fields-box">
                            <Label text="Category:" styleClass="form-label"/>
                            <ComboBox fx:id="filterCategoryCombo" promptText="All Categories" styleClass="combo-box" prefWidth="160"/>
                            <Label text="Min:" styleClass="form-label"/>
                            <TextField fx:id="filterMinAmount" promptText="0" styleClass="text-field" prefWidth="80"/>
                            <Label text="Max:" styleClass="form-label"/>
                            <TextField fx:id="filterMaxAmount" promptText="Any" styleClass="text-field" prefWidth="80"/>
                            <Button text="Clear" styleClass="secondary-button" onAction="#handleClearFilters"/>
                        </HBox>
                    </VBox>

                    <!-- Expense Table -->
                    <TableView fx:id="expenseTable" styleClass="table-view,editable-table" VBox.vgrow="ALWAYS" prefHeight="500">
                        <columns>
                            <TableColumn fx:id="amountColumn" text="Amount" prefWidth="100">
                                <cellValueFactory><PropertyValueFactory property="amount"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="expenseCategoryColumn" text="Category" prefWidth="150">
                                <cellValueFactory><PropertyValueFactory property="category"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="dateColumn" text="Date" prefWidth="120">
                                <cellValueFactory><PropertyValueFactory property="date"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="250">
                                <cellValueFactory><PropertyValueFactory property="description"/></cellValueFactory>
                            </TableColumn>
                        </columns>
                    </TableView>

                    <!-- Selectable detail bar for selected expense -->
                    <HBox fx:id="detailBar" spacing="8" alignment="CENTER_LEFT" visible="false" managed="false" styleClass="detail-bar">
                        <padding><Insets top="6" right="10" bottom="6" left="10"/></padding>
                        <Label text="Selected:" styleClass="form-label"/>
                        <TextField fx:id="detailText" editable="false" styleClass="detail-text-field" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>
            </ScrollPane>

            <!-- ==================== RECURRING VIEW ==================== -->
            <ScrollPane fx:id="recurringView" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane" visible="false" managed="false">
                <VBox fx:id="recurringTabContent" spacing="12" styleClass="content-view">
                    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

                    <Label text="Recurring Expenses" styleClass="view-title"/>

                    <!-- Add Recurring Form -->
                    <TitledPane text="Add New Recurring Expense" expanded="true" styleClass="form-titled-pane">
                        <VBox spacing="8" styleClass="panel-box">
                            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

                            <HBox spacing="16">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Amount:" styleClass="form-label"/>
                                    <TextField fx:id="addRecurringAmountField" promptText="e.g., 10.99" styleClass="text-field"/>
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Category:" styleClass="form-label"/>
                                    <ComboBox fx:id="addRecurringCategoryCombo" promptText="Select or enter category" styleClass="combo-box" maxWidth="1.7976931348623157E308"/>
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Start Date:" styleClass="form-label"/>
                                    <DatePicker fx:id="addRecurringDatePicker" promptText="Select Date" styleClass="date-picker" maxWidth="1.7976931348623157E308"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="16">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Frequency:" styleClass="form-label"/>
                                    <ComboBox fx:id="addRecurringFreqCombo" promptText="Select frequency" styleClass="combo-box" maxWidth="1.7976931348623157E308"/>
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Description (optional):" styleClass="form-label"/>
                                    <TextField fx:id="addRecurringDescField" promptText="Enter description" styleClass="text-field"/>
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="End Date (optional):" styleClass="form-label"/>
                                    <DatePicker fx:id="addRecurringEndDatePicker" promptText="Select end date" styleClass="date-picker" maxWidth="1.7976931348623157E308"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="10">
                                <Button text="Add Recurring Expense" styleClass="success-button" onAction="#handleAddRecurring"/>
                                <Button text="Add Category" styleClass="secondary-button" onAction="#handleAddCategory"/>
                                <Button text="Remove Category" styleClass="secondary-button" onAction="#handleRemoveCategory"/>
                            </HBox>
                            <Label fx:id="addRecurringErrorLabel" styleClass="error-label"/>
                        </VBox>
                    </TitledPane>

                    <!-- Detect Recurring Patterns -->
                    <Button text="Detect Recurring Patterns" styleClass="primary-button" onAction="#handleDetectRecurring" maxWidth="1.7976931348623157E308"/>

                    <!-- Manage Recurring Expenses -->
                    <VBox spacing="8" styleClass="panel-box">
                        <Label text="Manage Recurring Expenses" styleClass="section-title"/>
                        <TableView fx:id="recurringTable" styleClass="table-view" prefHeight="250">
                            <columns>
                                <TableColumn text="Amount" prefWidth="80">
                                    <cellValueFactory><PropertyValueFactory property="amount"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Category" prefWidth="100">
                                    <cellValueFactory><PropertyValueFactory property="category"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Start Date" prefWidth="100">
                                    <cellValueFactory><PropertyValueFactory property="date"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Description" prefWidth="120">
                                    <cellValueFactory><PropertyValueFactory property="description"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Frequency" prefWidth="80">
                                    <cellValueFactory><PropertyValueFactory property="frequency"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="End Date" prefWidth="80">
                                    <cellValueFactory><PropertyValueFactory property="endDate"/></cellValueFactory>
                                </TableColumn>
                            </columns>
                        </TableView>
                        <HBox spacing="10">
                            <Button text="Delete Selected" styleClass="danger-button" onAction="#handleDeleteRecurring"/>
                        </HBox>
                    </VBox>

                    <!-- Edit Recurring Form -->
                    <VBox spacing="8" styleClass="panel-box">
                        <Label text="Edit Selected Recurring Expense" styleClass="section-title"/>

                        <HBox spacing="16">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Amount:" styleClass="form-label"/>
                                <TextField fx:id="editRecurringAmountField" promptText="e.g., 10.99" styleClass="text-field"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Category:" styleClass="form-label"/>
                                <ComboBox fx:id="editRecurringCategoryCombo" promptText="Select category" styleClass="combo-box" maxWidth="1.7976931348623157E308"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Start Date:" styleClass="form-label"/>
                                <DatePicker fx:id="editRecurringDatePicker" promptText="Select Date" styleClass="date-picker" maxWidth="1.7976931348623157E308"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="16">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Frequency:" styleClass="form-label"/>
                                <ComboBox fx:id="editRecurringFreqCombo" promptText="Select frequency" styleClass="combo-box" maxWidth="1.7976931348623157E308"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Description (optional):" styleClass="form-label"/>
                                <TextField fx:id="editRecurringDescField" promptText="Enter description" styleClass="text-field"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="End Date (optional):" styleClass="form-label"/>
                                <DatePicker fx:id="editRecurringEndDatePicker" promptText="Select end date" styleClass="date-picker" maxWidth="1.7976931348623157E308"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="10">
                            <Button fx:id="updateRecurringButton" text="Update Expense" styleClass="success-button" disable="true" onAction="#handleUpdateRecurring"/>
                        </HBox>
                        <Label fx:id="editRecurringErrorLabel" styleClass="error-label"/>
                    </VBox>
                </VBox>
            </ScrollPane>

            <!-- ==================== IMPORT VIEW ==================== -->
            <ScrollPane fx:id="importView" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane" visible="false" managed="false">
                <VBox spacing="12" styleClass="content-view">
                    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

                    <Label text="Import" styleClass="view-title"/>

                    <HBox spacing="16">
                        <VBox spacing="8" styleClass="panel-box" HBox.hgrow="ALWAYS">
                            <Label text="Scan Receipt" styleClass="section-title"/>
                            <Label text="Scan a receipt image (JPG, PNG, BMP, TIFF) to extract line items via OCR." styleClass="form-label" wrapText="true"/>
                            <Button text="Scan Receipt Image..." styleClass="success-button" onAction="#handleScanReceipt"/>
                        </VBox>
                        <VBox spacing="8" styleClass="panel-box" HBox.hgrow="ALWAYS">
                            <Label text="Import Bank Statement" styleClass="section-title"/>
                            <Label text="Import transactions from a PDF bank statement or CSV file." styleClass="form-label" wrapText="true"/>
                            <Button text="Import Bank Statement..." styleClass="success-button" onAction="#handleImportStatement"/>
                        </VBox>
                        <VBox spacing="8" styleClass="panel-box" HBox.hgrow="ALWAYS">
                            <Label text="Import History" styleClass="section-title"/>
                            <Label text="View previous imports and their results." styleClass="form-label" wrapText="true"/>
                            <Button text="View Import History..." styleClass="primary-button" onAction="#handleShowImportHistory"/>
                        </VBox>
                    </HBox>

                    <!-- Auto-Categorization Rules -->
                    <VBox spacing="8" styleClass="panel-box">
                        <Label text="Auto-Categorization Rules" styleClass="section-title"/>
                        <Label text="Keywords matched against transaction descriptions to auto-assign categories." styleClass="form-label"/>
                        <TableView fx:id="rulesTable" styleClass="table-view" prefHeight="250">
                            <columns>
                                <TableColumn text="Keyword" prefWidth="250">
                                    <cellValueFactory><PropertyValueFactory property="keyword"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Category" prefWidth="250">
                                    <cellValueFactory><PropertyValueFactory property="category"/></cellValueFactory>
                                </TableColumn>
                            </columns>
                        </TableView>
                        <HBox spacing="10">
                            <Button text="Add Rule" styleClass="primary-button" onAction="#handleAddRule"/>
                            <Button text="Remove Rule" styleClass="danger-button" onAction="#handleRemoveRule"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Re-categorize" styleClass="primary-button" onAction="#handleRecategorize">
                                <tooltip><Tooltip text="Re-run rules on all uncategorized expenses"/></tooltip>
                            </Button>
                        </HBox>
                    </VBox>
                    <Label fx:id="importErrorLabel" styleClass="error-label"/>
                </VBox>
            </ScrollPane>

            <!-- ==================== ANALYTICS VIEW ==================== -->
            <ScrollPane fx:id="analyticsView" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane" visible="false" managed="false">
                <VBox spacing="12" styleClass="content-view">
                    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Analytics" styleClass="view-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="View by:" styleClass="form-label"/>
                        <ComboBox fx:id="chartPeriodCombo" styleClass="combo-box"/>
                    </HBox>

                    <TabPane fx:id="analyticsTabPane" styleClass="analytics-tab-pane" tabClosingPolicy="UNAVAILABLE">
                        <tabs>
                            <!-- Overview Tab -->
                            <Tab text="Overview">
                                <VBox spacing="8">
                                    <padding><Insets top="12" right="8" bottom="8" left="8"/></padding>
                                    <PieChart fx:id="categoryChart" title="Expenses by Category" legendVisible="false" prefHeight="300" styleClass="chart"/>
                                    <StackedBarChart fx:id="monthlyTrendChart" title="Monthly Trend" legendVisible="false" prefHeight="350" styleClass="chart">
                                        <xAxis><CategoryAxis/></xAxis>
                                        <yAxis><NumberAxis/></yAxis>
                                    </StackedBarChart>
                                    <FlowPane fx:id="trendChartLegend" hgap="12" vgap="6" alignment="CENTER" styleClass="custom-chart-legend">
                                        <padding><Insets top="4" right="8" bottom="4" left="8"/></padding>
                                    </FlowPane>
                                    <Label text="Expenses by Category" styleClass="table-title"/>
                                    <TableView fx:id="categoryTable" styleClass="table-view" prefHeight="200">
                                        <columns>
                                            <TableColumn fx:id="categoryNameColumn" text="Category" prefWidth="120">
                                                <cellValueFactory><PropertyValueFactory property="category"/></cellValueFactory>
                                            </TableColumn>
                                            <TableColumn fx:id="categoryTotalColumn" text="Spent" prefWidth="100">
                                                <cellValueFactory><PropertyValueFactory property="total"/></cellValueFactory>
                                            </TableColumn>
                                            <TableColumn fx:id="budgetColumn" text="Budget" prefWidth="100">
                                                <cellValueFactory><PropertyValueFactory property="budget"/></cellValueFactory>
                                            </TableColumn>
                                            <TableColumn fx:id="progressColumn" text="Progress" prefWidth="150">
                                                <cellValueFactory><PropertyValueFactory property="progress"/></cellValueFactory>
                                            </TableColumn>
                                        </columns>
                                    </TableView>
                                </VBox>
                            </Tab>

                            <!-- Income & Budget Tab -->
                            <Tab text="Income &amp; Budget">
                                <VBox spacing="8">
                                    <padding><Insets top="12" right="8" bottom="8" left="8"/></padding>
                                    <BarChart fx:id="incomeVsExpensesChart" title="Income vs Expenses" legendVisible="true" prefHeight="320" styleClass="chart">
                                        <xAxis><CategoryAxis/></xAxis>
                                        <yAxis><NumberAxis/></yAxis>
                                    </BarChart>
                                    <Label fx:id="budgetVsActualSubtitle" styleClass="chart-subtitle"/>
                                    <BarChart fx:id="budgetVsActualChart" title="Budget vs Actual" legendVisible="true" prefHeight="320" styleClass="chart">
                                        <xAxis><CategoryAxis/></xAxis>
                                        <yAxis><NumberAxis/></yAxis>
                                    </BarChart>
                                </VBox>
                            </Tab>

                            <!-- Spending Trends Tab -->
                            <Tab text="Spending Trends">
                                <VBox spacing="8">
                                    <padding><Insets top="12" right="8" bottom="8" left="8"/></padding>
                                    <Label fx:id="cumulativeSubtitle" styleClass="chart-subtitle"/>
                                    <LineChart fx:id="cumulativeSpendingChart" title="Cumulative Spending" legendVisible="true" prefHeight="320" createSymbols="false" styleClass="chart">
                                        <xAxis><NumberAxis label="Day of Month"/></xAxis>
                                        <yAxis><NumberAxis label="Amount"/></yAxis>
                                    </LineChart>
                                    <StackedAreaChart fx:id="categoryTrendChart" title="Category Trends" legendVisible="true" prefHeight="320" createSymbols="false" styleClass="chart">
                                        <xAxis><CategoryAxis/></xAxis>
                                        <yAxis><NumberAxis/></yAxis>
                                    </StackedAreaChart>
                                </VBox>
                            </Tab>

                            <!-- Comparisons Tab -->
                            <Tab text="Comparisons">
                                <VBox spacing="8">
                                    <padding><Insets top="12" right="8" bottom="8" left="8"/></padding>
                                    <LineChart fx:id="yearOverYearChart" title="Year-over-Year" legendVisible="true" prefHeight="320" createSymbols="true" styleClass="chart">
                                        <xAxis><CategoryAxis/></xAxis>
                                        <yAxis><NumberAxis/></yAxis>
                                    </LineChart>
                                    <PieChart fx:id="recurringVsOneTimeChart" title="Recurring vs One-Time" legendVisible="true" prefHeight="320" styleClass="chart"/>
                                </VBox>
                            </Tab>

                            <!-- Projections Tab -->
                            <Tab text="Projections" fx:id="projectionsTab">
                                <VBox spacing="10" fx:id="projectionsContent">
                                    <padding><Insets top="12" right="8" bottom="12" left="8"/></padding>

                                    <VBox spacing="4" styleClass="projection-header">
                                        <Label fx:id="projPeriodLabel" text="" styleClass="projection-period-label"/>
                                        <Label fx:id="projMethodLabel" text="" styleClass="projection-method-label" wrapText="true"/>
                                    </VBox>

                                    <HBox spacing="12" alignment="CENTER_LEFT" fx:id="projectionCards">
                                        <VBox styleClass="dashboard-card" alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS">
                                            <Label text="Projected Expenses" styleClass="dashboard-card-title"/>
                                            <Label fx:id="projExpenses" text="-" styleClass="dashboard-card-value"/>
                                            <Label fx:id="projExpensesSubtitle" text="" styleClass="dashboard-card-subtitle"/>
                                        </VBox>
                                        <VBox styleClass="dashboard-card" alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS">
                                            <Label text="Projected Income" styleClass="dashboard-card-title"/>
                                            <Label fx:id="projIncome" text="-" styleClass="dashboard-card-value"/>
                                            <Label fx:id="projIncomeSubtitle" text="" styleClass="dashboard-card-subtitle"/>
                                        </VBox>
                                        <VBox styleClass="dashboard-card" alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS">
                                            <Label text="Net Savings" styleClass="dashboard-card-title"/>
                                            <Label fx:id="projNetSavings" text="-" styleClass="dashboard-card-value"/>
                                            <Label fx:id="projNetSavingsSubtitle" text="" styleClass="dashboard-card-subtitle"/>
                                        </VBox>
                                        <VBox styleClass="dashboard-card" alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS">
                                            <Label text="6-Month Savings" styleClass="dashboard-card-title"/>
                                            <Label fx:id="projCumulativeSavings" text="-" styleClass="dashboard-card-value"/>
                                        </VBox>
                                    </HBox>

                                    <Label fx:id="projTrendIndicator" text="" styleClass="projection-trend-label"/>
                                    <Label fx:id="projNoDataLabel" text="" styleClass="chart-subtitle" managed="false" visible="false"/>

                                    <LineChart fx:id="projOutlookChart" title="6-Month Financial Outlook" legendVisible="true" prefHeight="300" createSymbols="true" styleClass="chart">
                                        <xAxis><CategoryAxis/></xAxis>
                                        <yAxis><NumberAxis/></yAxis>
                                    </LineChart>

                                    <AreaChart fx:id="projBalanceChart" title="Balance Trajectory" legendVisible="true" prefHeight="300" createSymbols="false" styleClass="chart projection-area-chart">
                                        <xAxis><CategoryAxis/></xAxis>
                                        <yAxis><NumberAxis/></yAxis>
                                    </AreaChart>

                                    <StackedBarChart fx:id="projCategoryChart" title="Projected Category Breakdown" legendVisible="false" prefHeight="300" styleClass="chart">
                                        <xAxis><CategoryAxis/></xAxis>
                                        <yAxis><NumberAxis/></yAxis>
                                    </StackedBarChart>
                                </VBox>
                            </Tab>
                        </tabs>
                    </TabPane>
                </VBox>
            </ScrollPane>

        </StackPane>
    </center>

    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="20">
            <padding><Insets top="4" right="15" bottom="4" left="15"/></padding>
            <Label fx:id="statusSaveLabel" text="Ready" styleClass="status-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusCountLabel" text="" styleClass="status-text"/>
            <Label text="F1 for shortcuts" styleClass="status-hint"/>
        </HBox>
    </bottom>
</BorderPane>
